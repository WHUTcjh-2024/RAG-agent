CATALOG_DB_PATH=backend/data/sqlite/app.db
# SQLITE_PATH is retained as a legacy alias for existing deployments.
SQLITE_PATH=backend/data/sqlite/app.db
CATALOG_DIR=backend/data/tianchi-catalog
CATALOG_IMAGE_DIR=backend/data/tianchi-catalog/images
SESSION_DB_PATH=backend/data/sqlite/sessions.db
AGENT_CHECKPOINT_DB_PATH=backend/data/sqlite/agent_checkpoints.db
AGENT_WORKFLOW_ENABLED=true
TEXT_INDEX_DIR=backend/data/vector_store/text
IMAGE_INDEX_DIR=backend/data/vector_store/image
IMAGE_DEVICE=auto
# 生产镜像构建时设为 1，生成 CLIP 商品图片索引；日常开发和 CI 保持 0。
BUILD_IMAGE_INDEX=0

# Retrieval reranking. `lexical` is deterministic; `cross-encoder` downloads/loads RERANKER_MODEL.
RERANKER_BACKEND=lexical
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional. Without these values, the agent uses deterministic grounded reasons.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_THINKING=disabled
LLM_ENABLED=false

# Java gateway
RAG_UPSTREAM_BASE_URL=http://127.0.0.1:18000
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
AGENT_INTERNAL_TOKEN=replace-with-a-random-internal-token
AGENT_ACTION_SECRET=replace-with-the-same-internal-token
AGENT_FACTS_BASE_URL=http://127.0.0.1:8080
AGENT_FACTS_INTERNAL_TOKEN=replace-with-the-same-internal-token
AGENT_CONTEXT_TOKEN=replace-with-the-same-internal-token

# Virtual try-on inference endpoint. It receives a synthetic body_profile plus garment_image,
# returns an image response or JSON with image_base64/b64_json, and must run behind HTTPS in production.
VTO_PROVIDER_URL=https://try-on.example.com/v1/generate
VTO_PROVIDER_API_KEY=
VTO_RESULT_SIGNING_SECRET=replace-with-a-random-result-url-signing-secret
VTO_PROVIDER_TIMEOUT_SECONDS=75
VTO_RESULT_TTL_HOURS=24
VTO_SAVED_RESULT_TTL_HOURS=168
VTO_MAX_CONCURRENT_JOBS=2
VTO_RATE_LIMIT_COUNT=10
VTO_RATE_LIMIT_WINDOW_SECONDS=600
VTO_REDIS_URL=redis://:replace-with-the-redis-password@redis:6379/1
VTO_REDIS_PREFIX=fitme:vto
VTO_S3_ENDPOINT_URL=http://minio:9000
VTO_S3_BUCKET=fitme-tryon
VTO_S3_REGION=us-east-1
VTO_S3_ACCESS_KEY=fitme
VTO_S3_SECRET_KEY=replace-with-a-strong-minio-password

# Private S3-compatible object storage for synthetic try-on results.
MINIO_ROOT_USER=fitme
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_BUCKET=fitme-tryon

# Java production dependencies used by docker-compose.yml
POSTGRES_DB=atelier
POSTGRES_USER=atelier
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_MAXMEMORY=256mb
