# All durable backend state (catalog, agent memory, checkpoints, try-on jobs)
# lives in PostgreSQL. There is no SQLite fallback.
CATALOG_DATABASE_URL=postgresql://atelier:replace-with-a-strong-postgres-password@postgres:5432/atelier
CATALOG_DIR=backend/data/tianchi-catalog
CATALOG_IMAGE_DIR=backend/data/tianchi-catalog/images
AGENT_MEMORY_BACKEND=postgres
AGENT_MEMORY_DATABASE_URL=postgresql://atelier:replace-with-a-strong-postgres-password@postgres:5432/atelier
AGENT_MEMORY_AUTO_SETUP=false
AGENT_WORKFLOW_ENABLED=true
# Production must explicitly select Postgres checkpointing and a Redis lease;
# it does not silently fall back to a local file.
AGENT_CHECKPOINT_BACKEND=postgres
AGENT_CHECKPOINT_DATABASE_URL=postgresql://atelier:replace-with-a-strong-postgres-password@postgres:5432/atelier
AGENT_CHECKPOINT_AUTO_SETUP=false
AGENT_TASK_LOCK_BACKEND=local
AGENT_REDIS_URL=redis://:replace-with-the-redis-password@redis:6379/2
AGENT_TASK_LOCK_PREFIX=atelier:agent:task-lock
AGENT_TASK_LOCK_TTL_SECONDS=90
AGENT_TASK_LOCK_ACQUIRE_TIMEOUT_SECONDS=3
OTEL_SERVICE_NAME=atelier-agent-api
# Empty means no remote trace exporter; the application retains only a small, redacted local diagnostic buffer.
OTEL_EXPORTER_OTLP_ENDPOINT=
TEXT_INDEX_DIR=backend/data/vector_store/text
IMAGE_INDEX_DIR=backend/data/vector_store/image
IMAGE_DEVICE=auto
# 生产镜像构建时设为 1，生成 CLIP 商品图片索引；日常开发和 CI 保持 0。
BUILD_IMAGE_INDEX=0

# Retrieval reranking. `lexical` is deterministic; `cross-encoder` downloads/loads RERANKER_MODEL.
RERANKER_BACKEND=lexical
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional. Without these values, the agent uses deterministic grounded reasons.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_THINKING=disabled
LLM_ENABLED=false

# Java gateway
RAG_UPSTREAM_BASE_URL=http://127.0.0.1:18000
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
AGENT_INTERNAL_TOKEN=replace-with-a-random-internal-token
AGENT_ACTION_SECRET=replace-with-the-same-internal-token
AGENT_FACTS_BASE_URL=http://127.0.0.1:8080
AGENT_FACTS_INTERNAL_TOKEN=replace-with-the-same-internal-token
AGENT_CONTEXT_TOKEN=replace-with-the-same-internal-token

# Virtual try-on inference endpoint. It receives a synthetic body_profile plus garment_image,
# returns an image response or JSON with image_base64/b64_json, and must run behind HTTPS in production.
VTO_PROVIDER_URL=https://try-on.example.com/v1/generate
VTO_PROVIDER_API_KEY=
VTO_RESULT_SIGNING_SECRET=replace-with-a-random-result-url-signing-secret
# Try-on job state. Either this or VTO_REDIS_URL (production, horizontally scaled) is required.
VTO_DATABASE_URL=postgresql://atelier:replace-with-a-strong-postgres-password@postgres:5432/atelier

# Java try-on scheduler: bounded worker pool, idempotency, rate limiting and retries.
TRYON_WORKER_COUNT=4
TRYON_QUEUE_CAPACITY=128
TRYON_MAX_ATTEMPTS=3
TRYON_RATE_LIMIT_COUNT=10
TRYON_RATE_LIMIT_WINDOW=10m
TRYON_RESULT_TTL=24h
TRYON_SAVED_RESULT_TTL=168h
TRYON_PROVIDER_TIMEOUT=90s
TRYON_PROCESSING_LEASE=2m
TRYON_POLL_INTERVAL_MS=200
TRYON_RECOVERY_INTERVAL_MS=30000

# Java production dependencies used by docker-compose.yml
POSTGRES_DB=atelier
POSTGRES_USER=atelier
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_MAXMEMORY=256mb
